# Copy this file to .env and replace placeholders with your own values.
# Never commit .env or paste secret values into chat.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Local development only. Live GCash requires your public HTTPS website origin.
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Optional until live GCash is enabled. Keep these server-side and private.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional until distance-based delivery is enabled.
GOOGLE_MAPS_ROUTES_API_KEY=
